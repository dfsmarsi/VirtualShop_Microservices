@model CartViewModel

@if (Model.CartHeader is not null && Model.CartItems.Any())
{
    <div class="container mt-4 mb-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-cart-shopping"></i> &nbsp;Shopping Cart</span>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-light btn-sm">
                    <i class="fa-solid fa-arrow-left"></i> Continue Shopping
                </a>
            </div>

            <div class="card-body">
                <div class="d-none d-lg-flex text-muted small fw-semibold border-bottom pb-2 mb-2">
                    <div class="col-lg-6">Product</div>
                    <div class="col-lg-2 text-center">Price</div>
                    <div class="col-lg-2 text-center">Quantity</div>
                    <div class="col-lg-2 text-end">Subtotal</div>
                </div>

                @foreach (var item in Model.CartItems)
                {
                    <div class="row align-items-center py-3 border-bottom">
                        <div class="col-3 col-lg-2">
                            <partial name="_ProductImage" model='(item.Product.ImageUrl, item.Product.Name, "rounded", "width:100%;height:80px;object-fit:cover;")' />
                        </div>
                        <div class="col-9 col-lg-4">
                            <h6 class="mb-1">@item.Product.Name</h6>
                            <p class="text-muted small mb-0">@item.Product.Description</p>
                        </div>
                        <div class="col-6 col-lg-2 text-lg-center mt-2 mt-lg-0 fw-semibold text-primary">
                            @(item.Product.Price?.ToString("C") ?? "-")
                        </div>
                        <div class="col-3 col-lg-2 text-lg-center mt-2 mt-lg-0">
                            <span class="badge bg-light text-dark border">Qty: @item.Quantity</span>
                        </div>
                        <div class="col-3 col-lg-2 text-end mt-2 mt-lg-0 d-flex justify-content-end align-items-center gap-2">
                            <span class="fw-bold">@(((item.Product.Price ?? 0) * item.Quantity).ToString("C"))</span>
                            <a asp-action="RemoveItem" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Remove item">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        </div>
                    </div>
                }

                <div class="row mt-4">
                    <div class="col-md-6">
                        <label class="fw-semibold small text-muted d-block mb-1">Discount coupon</label>
                        @if (string.IsNullOrEmpty(Model.CartHeader.CouponCode))
                        {
                            <form asp-action="ApplyCounpon" method="post">
                                <input asp-for="CartHeader.Id" hidden />
                                <input asp-for="CartHeader.UserId" hidden />
                                <div class="input-group">
                                    <input asp-for="CartHeader.CouponCode" class="form-control" placeholder="Coupon code" />
                                    <button type="submit" class="btn btn-outline-secondary">Apply</button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <form asp-action="RemoveCoupon" method="post">
                                <div class="input-group">
                                    <input asp-for="CartHeader.CouponCode" class="form-control" disabled />
                                    <button type="submit" class="btn btn-outline-danger">Remove</button>
                                </div>
                            </form>
                        }
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <span class="text-muted d-block">Total</span>
                        <span class="text-danger fw-bold fs-3">@Model.CartHeader.TotalAmount.ToString("C")</span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white text-end">
                <a asp-action="Checkout" class="btn btn-primary px-4">
                    Checkout <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3"></i>
        <p class="fs-5">Your cart is empty. Start shopping now!</p>
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Go Shopping</a>
    </div>
}
